  "Specification": {
    "Schema": "riido-wrap-marshal75-finite-want-v1",
    "Goals": [
      {
        "ID": "wordwrap-whitespace-layout",
        "API": "wordwrap.WrapString",
        "Repository": "mitchellh/go-wordwrap",
        "Revision": "ecf0936a077a4bd73a1cc2ac5c370f2b55618d62",
        "SourceSHA256": "a924b1cb3b0e04c603019e608d3196275cea56bbd1aab82af04d0996fb7a86ee",
        "Derivation": "Pinned source buffers word/space runes separately, preserves explicit LF, excludes NBSP from Unicode whitespace, only inserts a break while wordBufLen \u003c lim, and handles trailing spaces separately. Fixed manual outputs are sealed before native dispatch.",
        "ExcludedScope": "No general Unicode grapheme/display-column width, smarter word splitting, arbitrary input, full whitespace grammar, universal no-panic promise or new independent parents."
      },
      {
        "ID": "godotenv-canonical-marshal",
        "API": "godotenv.Marshal",
        "Repository": "joho/godotenv",
        "Revision": "97a2850142438b3c357c1d3439e325181afdcc1d",
        "SourceSHA256": "c4bfd90250cd5caf760bc91ef0eeb8748b1596e2d720ac0d944e8079cc9d0488",
        "Derivation": "Pinned isInt strips at most one leading '-' and accepts nonempty ASCII digits with no numeric conversion/length cap. Marshal escapes seven fixed characters for other values, sorts whole lines, joins LF with no final LF and returns nil error. Inputs are only explicit in-memory literal maps.",
        "ExcludedScope": "No Load/Read/Write/Parse/Unmarshal/Exec/autoload or environment/filesystem lookup; no dotenv roundtrip, key validation, general error/caption/label/readiness promise."
      }
    ],
