  "requests": [
    {
      "ordinal": 0,
      "id": "go53-afero-union-pagination",
      "request": "Define and implement cursor advancement for mixed positive-count and read-all UnionFile directory calls, with stable layer precedence and no duplicate entries.",
      "display_to_internal": [
        "cached_cursor",
        "original_union",
        "read_all_from_zero"
      ],
      "captions": [
        {
          "display": 0,
          "text": "Cache one merged view, preserve overlay entries, and advance one cursor for positive and read-all calls, including empty directories and repeated EOF.",
          "bytes": 150,
          "space_words": 22
        },
        {
          "display": 1,
          "text": "Delegate mixed directory reads to UnionFile.Readdir, retaining the original cached merge and positive-count cursor handling.",
          "bytes": 124,
          "space_words": 15
        },
        {
          "display": 2,
          "text": "Cache a merged view, but serve every read-all call from entry zero before marking the view consumed.",
          "bytes": 100,
          "space_words": 17
        }
      ],
      "family_context": {
        "existing_group": 79,
        "existing_role": "development_train",
        "new_assignment": null
      },
      "realization": "Consuming read-all and positive calls share one merged snapshot/cursor. Same owned public Merger fixes order and overlay precedence for all candidates. Original default ordering is excluded."
    },
    {
      "ordinal": 1,
      "id": "hyp52-gjson-duplicate-object-keys",
      "request": "Add an opt-in valid-JSON policy that rejects repeated decoded keys in each object before publishing collapsed views, including nested objects and arrays; preserve existing parsing defaults.",
      "display_to_internal": [
        "original_map_view",
        "raw_spelling_policy",
        "decoded_local_policy"
      ],
      "captions": [
        {
          "display": 0,
          "text": "Validate JSON syntax, then publish recursive Map views without a duplicate rejection channel; retain the first decoded value for each key.",
          "bytes": 138,
          "space_words": 21
        },
        {
          "display": 1,
          "text": "Walk valid JSON before publication and reject repeated raw key spellings within each object, including nested objects and arrays.",
          "bytes": 129,
          "space_words": 19
        },
        {
          "display": 2,
          "text": "Walk valid JSON before publication and reject repeated decoded keys within each object, stopping at the first duplicate and preserving its object path.",
          "bytes": 151,
          "space_words": 23
        }
      ],
      "family_context": {
        "existing_group": 83,
        "existing_members": [
          "GJSON",
          "Match",
          "Pretty"
        ],
        "existing_role": "development_train",
        "new_assignment": null
      },
      "realization": "ForEach already exposes duplicates; this is rejection-before-collapse via an owned wrapper policy, not a missing iteration or syntax-validation API."
    }
  ],
