    {
      "ID": "datasize-unit-parse-state",
      "API": "(*datasize.ByteSize).UnmarshalText",
      "Repository": "c2h5oh/datasize",
      "Revision": "aa82cc1e65004e2b59a6e44d26f774ca961b24d8",
      "SourceSHA256": "512932730df3f5b92b025ccb03cb534670b9f9d77edc201f58ffbee711a583d9",
      "Derivation": "Read pinned decimal parsing, binary unit multiplier and terminal receiver assignments. Expected integers are fixed independently before calls; pure big.Int toy checks verify literal boundaries.",
      "ExcludedScope": "No nil receiver, arbitrary input, all units, fractional grammar or stronger atomic-state promise."
    },
    {
      "ID": "query-tagged-multivalue",
      "API": "query.Values",
      "Repository": "google/go-querystring",
      "Revision": "965d79f2113ea0ff039d29828a08a616a0223d48",
      "SourceSHA256": "644ee90c8857903116e74980705bc54a2bd671afbbfcba3f08f7993b6e083ff7",
      "Derivation": "Read Values documentation, nil return path, struct validation, omitempty, repeated slice order and nested bracket names. Only six trusted primitive fixtures; sorted keys preserve value order and map nil state.",
      "ExcludedScope": "No callbacks, Encoder/IsZero/Stringer, time, cyclic/recursive actor input or arbitrary structs."
    },
    {
      "ID": "shlex-quoted-argv",
      "API": "shlex.Split",
      "Repository": "google/shlex",
      "Revision": "e7afc7fbc51079733e9468cdfd1efcd7d196cd1d",
      "SourceSHA256": "f34d676ee244f328c7cb43ff9cb285562df0afde0dc49a7d4f9705fe2703220b",
      "Derivation": "Read quoted/escaping/comment state transitions and Split append-after-success loop. Eight fixed literals preserve empty words, completed prefix on malformed EOF, and nonnil empty slice.",
      "ExcludedScope": "No POSIX-shell equivalence, expansion/substitution/execution, arbitrary Reader or general no-panic promise."
    }
  ],
