      "symbol_or_fields": "check: clone/input-preservation/output slices.Equal/panic unknown",
      "text": "func check(fn func([]int) []int, vectors []vector) (checked, failed int, unknown bool) {\n\tdefer func() {\n\t\tif recover() != nil {\n\t\t\tunknown = true\n\t\t}\n\t}()\n\tfor _, v := range vectors {\n\t\tinput := slices.Clone(v.Input)\n\t\tgot := fn(input)\n\t\tchecked++\n\t\tif !slices.Equal(input, v.Input) {\n\t\t\treturn checked, failed, true\n\t\t}\n\t\tif !slices.Equal(got, v.Want) {\n\t\t\tfailed++\n\t\t}\n\t}\n\treturn\n}\n",
      "whole_program_object_binding_claim": false
    },
