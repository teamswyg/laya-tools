    {
      "id": "AscendRange",
      "text": "AscendRange calls the iterator for every value in the tree within the range [greaterOrEqual, lessThan), until iterator returns false."
    },
    {
      "id": "AscendLessThan",
      "text": "AscendLessThan calls the iterator for every value in the tree within the range [first, pivot), until iterator returns false."
    },
    {
      "id": "AscendGreaterOrEqual",
      "text": "AscendGreaterOrEqual calls the iterator for every value in the tree within the range [pivot, last], until iterator returns false."
    },
    {
      "id": "Ascend",
      "text": "Ascend calls the iterator for every value in the tree within the range [first, last], until iterator returns false."
    },
    {
      "id": "DescendRange",
      "text": "DescendRange calls the iterator for every value in the tree within the range [lessOrEqual, greaterThan), until iterator returns false."
    },
    {
      "id": "DescendLessOrEqual",
      "text": "DescendLessOrEqual calls the iterator for every value in the tree within the range [pivot, first], until iterator returns false."
    },
    {
      "id": "DescendGreaterThan",
      "text": "DescendGreaterThan calls the iterator for every value in the tree within the range [last, pivot), until iterator returns false."
    },
    {
      "id": "Descend",
      "text": "Descend calls the iterator for every value in the tree within the range [last, first], until iterator returns false."
    }
